# Database
# SQLite (local/Railway): file:./prisma/dev.db
# For a hosted Postgres, use: postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./prisma/dev.db"

# JWT — generate with: openssl rand -hex 32
JWT_SECRET="your-jwt-secret-here"

# Google Gemini AI — https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# File Uploads — absolute path recommended in production
UPLOAD_DIR="./uploads"

# Server
PORT=5000

# CORS — set to your deployed frontend URL in production
# e.g. https://autoshield.vercel.app
CORS_ORIGIN="http://localhost:5173"

# Google Sign-In (optional) — OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Must match the frontend's VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=""
