generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  // Google OAuth — set when the user signs in with Google (password stays an
  // unguessable random hash for Google-only accounts)
  googleId     String?  @unique
  firstName    String
  lastName     String
  phone        String?
  address      String?
  // Insurance company records filled in by an admin
  nic          String?   // National Identity Card number (user registration)
  licenseType  String?   // Driving license class (e.g. A, B, B1, C)
  annualFee    Float?    // Annual insurance fee (LKR)
  joinedAt     DateTime? // Day the user joined the insurance company
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles        Vehicle[]
  policies        InsurancePolicy[]
  claims          Claim[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
}

model Vehicle {
  id           String   @id @default(uuid())
  userId       String
  make         String
  model        String
  year         Int
  vin          String?
  licensePlate String
  color        String
  // Vehicle class — drives AI detection, repair pricing scale and UI icons
  vehicleType  VehicleType @default(CAR)
  mileage      Int?
  photos       String @default("[]")
  // Vehicle valuation (LKR) set by the insurance company — caps claim payouts
  valuation    Float?
  // Insurance/admin verification of the vehicle and its policy — claims require VERIFIED
  verificationStatus VehicleVerification @default(PENDING)
  verifiedAt         DateTime?
  verificationNotes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims           Claim[]
  insurancePolicy  InsurancePolicy?
}

enum VehicleVerification {
  PENDING
  VERIFIED
  REJECTED
}

// Vehicle classes on Sri Lankan roads — the repair pricing engine scales its
// base (car) table by class, so every registered vehicle estimates correctly
enum VehicleType {
  CAR
  SUV_PICKUP
  VAN
  LORRY_TRUCK
  BUS
  MOTORCYCLE
  THREE_WHEELER
  TRACTOR
  OTHER
}

// Built-in insurance plans the company offers — one per insurance type (or several)
model PolicyTemplate {
  id              String   @id @default(uuid())
  name            String
  coverageType    String   // insurance type: Comprehensive, Third Party, ...
  description     String?
  deductible      Float    // amount deducted from each claim (LKR)
  coveragePercent Float    @default(100) // % of the remaining cost the policy covers
  annualFee       Float    // yearly premium (LKR)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  policies InsurancePolicy[]
}

model InsurancePolicy {
  id           String    @id @default(uuid())
  userId       String
  providerName String
  policyNumber String
  coverageType String
  deductible   Float
  premiumAmount Float
  coveragePercent Float   @default(100) // % covered after deductible
  templateId   String?
  // Vehicle this policy insures — one policy per vehicle (insurance is vehicle-based)
  vehicleId    String?   @unique
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template PolicyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  claims   Claim[]
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  GARAGE_REVIEW
  GARAGE_ESTIMATED
  APPROVED
  REJECTED
  COMPLETED
}

model Claim {
  id                  String      @id @default(uuid())
  userId              String
  vehicleId           String
  policyId            String?
  status              ClaimStatus @default(DRAFT)
  incidentDate        DateTime
  incidentLocation    String
  incidentDescription String
  weatherConditions   String?
  hasPoliceReport     Boolean     @default(false)
  // Final claimable amount (LKR) confirmed by the insurer — overrides the computed estimate once set
  finalClaimableValue Float?
  finalValueSetAt     DateTime?
  // Fraud scoring — 0 = no risk, 100 = maximum. Flags are the individual signals that contributed.
  fraudScore    Int?      @default(0)
  fraudFlags    Json?
  fraudSummary  String?
  fraudScoredAt DateTime?
  // Garage vs AI estimate reconciliation — 0 = aligned, 100 = high divergence
  reconciliationScore   Int?
  reconciliationResult  Json?
  reconciliationSummary String?
  reconciledAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  garageId            String?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  policy            InsurancePolicy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  garage            Garage?            @relation(fields: [garageId], references: [id], onDelete: SetNull)
  images            ClaimImage[]
  damageAssessment  DamageAssessment?
  repairEstimate    RepairEstimate?
  garageEstimate    GarageEstimate?
  insurancePayout   InsurancePayout?
  documents         Document[]
  chatMessages      ChatMessage[]
  adminNotes        AdminNote[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
}

enum ImageType {
  FULL_VEHICLE
  DAMAGE_CLOSEUP
}

model ClaimImage {
  id           String    @id @default(uuid())
  claimId      String
  type         ImageType
  filePath     String
  label        String?
  aiAnnotation Json?
  uploadedAt   DateTime  @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

enum SeverityLevel {
  MINOR
  MODERATE
  SEVERE
}

model DamageAssessment {
  id                   String        @id @default(uuid())
  claimId              String        @unique
  damages              Json
  drivabilityAssessment String
  overallSeverity      SeverityLevel
  aiRawResponse        Json?
  assessedAt           DateTime      @default(now())

  claim          Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  repairEstimate RepairEstimate?
}

model RepairEstimate {
  id                 String   @id @default(uuid())
  claimId            String   @unique
  damageAssessmentId String   @unique
  items              Json
  totalPartsCost     Float
  totalLaborCost     Float
  totalCost          Float
  estimatedDays      Int
  createdAt          DateTime @default(now())

  claim             Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  damageAssessment  DamageAssessment  @relation(fields: [damageAssessmentId], references: [id], onDelete: Cascade)
  insurancePayout   InsurancePayout?
}

model InsurancePayout {
  id              String   @id @default(uuid())
  claimId         String   @unique
  repairEstimateId String  @unique
  deductible      Float
  coveredAmount   Float
  estimatedPayout Float
  notes           String?
  createdAt       DateTime @default(now())

  claim          Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  repairEstimate RepairEstimate @relation(fields: [repairEstimateId], references: [id], onDelete: Cascade)
}

enum DocumentType {
  LICENSE
  REGISTRATION
  ACCIDENT_REPORT
  REPAIR_ESTIMATE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  ISSUES_FOUND
  UNREADABLE
}

model Document {
  id                 String             @id @default(uuid())
  claimId            String
  type               DocumentType
  filePath           String
  verificationStatus VerificationStatus @default(PENDING)
  verificationResult Json?
  uploadedAt         DateTime           @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        String   @id @default(uuid())
  claimId   String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model AdminNote {
  id        String   @id @default(uuid())
  claimId   String
  category  String   // "vehicle" | "document" | "general"
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model Garage {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  ownerName    String
  phone        String
  address      String
  city         String
  licenseNumber String
  specialties  String   @default("[]")
  isActive     Boolean  @default(true)
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  claims         Claim[]
  garageEstimates GarageEstimate[]
}

model GarageEstimate {
  id             String   @id @default(uuid())
  claimId        String   @unique
  garageId       String
  items          Json
  totalPartsCost Float
  totalLaborCost Float
  totalCost      Float
  estimatedDays  Int
  notes          String?
  // Date the estimate applies to — set by the garage; older rows fall back to submittedAt
  estimateDate   DateTime?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  claim  Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

// In-app notifications surfaced to the policyholder — auto-triggers (doc reminder,
// garage estimate, final value update) plus admin-composed messages.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  claimId   String?
  type      String   // DOC_REMINDER, GARAGE_ESTIMATE, FINAL_VALUE, ADMIN_MESSAGE
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim Claim? @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

// Problem reports filed by policyholders through the AI assistant chat
model SupportTicket {
  id         String   @id @default(uuid())
  userId     String
  claimId    String?
  subject    String
  message    String
  status     String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
}
