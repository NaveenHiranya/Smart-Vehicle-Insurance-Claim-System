# Backend API URL — leave empty in development (Vite proxy handles it)
# In production set this to your deployed backend origin (no trailing slash)
# e.g. https://autoshield-backend.railway.app
VITE_API_URL=

# Google Sign-In (optional) — OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Must match the backend's GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
