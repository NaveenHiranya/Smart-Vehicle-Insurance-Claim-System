{
  "name": "autoshield-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "cd backend && npm install && npm run build",
    "start": "cd backend && npm run start:migrate",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
